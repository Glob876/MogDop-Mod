{
  "schemaVersion": 1,
  "id": "mogdops-mod",
  "version": "${version}",
  "name": "MogDop's Mod",
  "description": "A Garry's Mod style sandbox toolkit & WorldEdit integration on Architectury API.",
  "authors": ["glob"],
  "contact": {},
  "license": "MIT",
  "icon": "assets/mogdops-mod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.mogdop.mod.fabric.MogDopSModFabric"
    ],
    "client": [
      "com.mogdop.mod.fabric.client.MogDopSModFabricClient"
    ],
    "modmenu": [
      "com.mogdop.mod.fabric.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "mogdops-mod.mixins.json",
    "mogdops-mod.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "fabric-api": "*",
    "architectury": ">=13.0.0"
  }
}